** sch_path: /run/media/yacinesot/My_Files/XschemDesigns/designs/Chipalooza2/schema/ota_cmfb_top_tb.sch
**.subckt ota_cmfb_top_tb
xprobe1 Vinp net3 Vinn net4 ac_diff_probe vcm={vcm_in} vac=1
Vmeas2 net1 Voutn 0
.save i(vmeas2)
Vmeas3 net2 Voutp 0
.save i(vmeas3)
Vmeas4 Voutp net4 0
.save i(vmeas4)
Vmeas5 Voutn net3 0
.save i(vmeas5)
R1 net5 Vinn 500k
R2 Vinn Vt_n 500k
R3 net6 Vinp 500k
R4 Vinp Vt_p 500k
XDIFF_AMP1 Vcm VDD EN Vinp net1 net2 Vinn VSS Ibias ota_cmfb_top
**** begin user architecture code


VSS VSS 0 0
VDD VDD VSS 1.5
VEN EN VSS 1.2
Vcm Vcm VSS {vcm}
Ibias VDD Ibias 2.5u



.control
op
let ro_n = voutn/i(vmeas2)
let ro_p = voutp/i(vmeas3)
print ro_n ro_p
write ota_cmfb_top_tb.raw
.endc



.control
ac dec 50 100 100G
let vout_diff = voutp-voutn
let vin_diff = vinp-vinn
let diff_gain=vout_diff/vin_diff
let op_mag=db(diff_gain)
let op_ph = 180*cph(diff_gain)/pi + 180
let vcm_1 = (voutp+voutn)/2
let vcm_err = mag((vcm_1 - {vcm}))[0]
echo results_save_begin
meas ac dc_gain find op_mag when frequency=1000
meas ac gain_margin find op_mag when op_ph=0
meas ac phase_margin find op_ph when op_mag=0
meas ac bw_3db find frequency when op_mag=dc_gain-3
meas ac Gain_BW find frequency when op_mag=0
print vcm_err
echo results_save_end
plot op_mag op_ph
.endc




.option rshunt=1e9
.options method=gear
.param vcm=0.75 vcm_in=0.75 cl=0.1p
.save all




CL1 Voutp 0 {cl}
CL2 Voutn 0 {cl}



.include ota_cmfb_top_tb.save



**nr_workers=1
**nr_mc_sims=100

**results_plot_begin
**dc_gain
**gain_margin
**phase_margin
**bw_3db
**Gain_BW
**vcm_err
**results_plot_end





